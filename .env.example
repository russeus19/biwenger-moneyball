# --- Biwenger -------------------------------------------------------------
# Opción A (recomendada para empezar): pega el token de DevTools.
#   F12 -> Network -> filtra "api/v2" -> Request Headers -> authorization: Bearer <esto>
BIWENGER_TOKEN=

# Opción B: credenciales. El cliente las canjea por token al arrancar y NO las persiste.
BIWENGER_EMAIL=
BIWENGER_PASSWORD=

# Estos dos no son secretos, son ids. Misma pantalla de DevTools.
BIWENGER_LEAGUE=
BIWENGER_USER=
# Cabecera x-version que manda la web. Cambia cada cierto tiempo.
BIWENGER_VERSION=

# Ruta del login. Verifícala en DevTools al iniciar sesión y corrígela si no coincide.
BIWENGER_LOGIN_PATH=/api/v2/auth/login

# Competición y fuente de puntuación (1 = AS, 2 = Sofascore, según lo que use tu liga)
BIWENGER_COMPETITION=la-liga
BIWENGER_SCORE=2

# Plantillas de imagen. {id} se sustituye por el id del jugador o del equipo.
# Estas son las reales, comprobadas contra el CDN. Solo hay que tocarlas si
# Biwenger cambia el esquema algún día.
BIWENGER_PLAYER_IMG=https://cdn.biwenger.com/i/p/{id}.png
BIWENGER_TEAM_IMG=https://cdn.biwenger.com/i/t/{id}.png

# --- Motor ----------------------------------------------------------------
# Jornadas que proyecta el modelo hacia delante
HORIZON_ROUNDS=6
# Partidos de "prior" para la regresión a la media (shrinkage). Más alto = más
# conservador. El simulador prefiere 3, los datos reales 5, y entre 3 y 5 la
# diferencia está dentro del ruido. 4 es el consenso.
SHRINKAGE_K=4
# Vida media en jornadas para la forma reciente. Ojo: los datos reales solo
# cubren 6 jornadas, donde una vida media larga parece mejor simplemente porque
# aún no hay racha que detectar. 8 es el consenso con el simulador.
FORM_HALFLIFE=8
# Vida media para estimar titularidad. Por defecto el doble que la forma.
MINUTES_HALFLIFE=6
# Nota a partir de la cual salta la alerta
ALERT_THRESHOLD=8

# Ajuste "Puja máxima" de tu liga (Ajustes -> Mercado -> Compras y Ventas):
#   saldo      = solo el saldo disponible, no se puede quedar en negativo
#   saldo25    = saldo + 25% del valor de tu plantilla (el recomendado por Biwenger)
#   saldo50    = saldo + 50%
#   ilimitada  = sin tope
BIWENGER_BID_MODE=saldo25

# --- Alertas --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Varios ---------------------------------------------------------------
DB_PATH=./data/biwenger.db
# Nombre corto del manager. Decide el fichero de salida (data/market-<slug>.json)
# y tiene que coincidir con el del array USUARIOS de web/index.html.
MANAGER_SLUG=dani
RAW_DIR=./data/raw
PORT=8787
